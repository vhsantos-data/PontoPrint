# Copie para .env e preencha. Em produção o servidor não sobe sem
# ADMIN_TOKEN (32+ caracteres) e IP_HASH_SALT.
# Gere valores com: npm run gen:token

NODE_ENV=development
PORT=3000

# 1 se estiver atrás de Nginx, Caddy, Cloudflare, Railway etc.
TRUST_PROXY=0
# URL pública do site (definir junto com o domínio — ver PENDENCIAS.md)
# PUBLIC_URL=https://pontoprint.com.br

# Acesso ao painel /admin. Gere com: npm run gen:token
# Deixe COMENTADO em desenvolvimento para usar o token de dev automático.
# Em produção é obrigatório e precisa ter 32+ caracteres.
# ADMIN_TOKEN=
# Sal do hash de IP (métricas sem identificar ninguém). Mesma regra acima.
# IP_HASH_SALT=

DB_PATH=./data/pontoprint.db
EVENTOS_RETENCAO_DIAS=180

# ---- Avisos de novo pedido (todos opcionais) ----

# Webhook: serve direto em n8n, Make ou Zapier para avisar no WhatsApp
# ou gravar numa planilha.
# NOTIFY_WEBHOOK_URL=

# E-mail. Com Gmail é preciso senha de app, não a senha da conta.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
