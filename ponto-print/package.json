{
  "name": "ponto-print",
  "version": "1.0.0",
  "description": "Landing page + API de orçamentos da Ponto Print (impressão e personalização)",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
