{
  "name": "Ponto Print",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Ponto Print", "onAutoForward": "notify" }
  },
  "postCreateCommand": "cp -n .env.example .env 2>/dev/null; npm install",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },
  "remoteEnv": {
    "NODE_ENV": "development"
  }
}
